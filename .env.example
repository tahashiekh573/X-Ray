# Backend settings (prefix XRAY_). Copy to .env and adjust. No secrets are required:
# the app uses no paid AI APIs and the backend calls no external services.

XRAY_ENVIRONMENT=development          # development | test | production
XRAY_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
XRAY_HOST=127.0.0.1
XRAY_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser (dev server shown)
XRAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve the built frontend (web/dist) from the backend
XRAY_SERVE_FRONTEND=true
# Privacy guard: maximum API request body size in bytes (API calls carry no media)
XRAY_MAX_REQUEST_BYTES=16384
# Send Strict-Transport-Security (enable only when served over HTTPS)
XRAY_ENABLE_HSTS=false

# Frontend dev server only: where /api is proxied to
VITE_DEV_API_TARGET=http://127.0.0.1:8000
