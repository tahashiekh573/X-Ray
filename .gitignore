# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/blob-report/

# Self-hosted MediaPipe runtime (re-created by `npm install` / `npm run setup:mediapipe`)
web/public/mediapipe/

# Raw source data for the asset pipeline (downloaded on demand, large)
data/raw/

# Fake-camera fixtures for E2E tests (generated by web/e2e/fixtures/make-fixtures.mjs)
web/e2e/fixtures/raw/
web/e2e/fixtures/*.y4m

# Secrets / local config
.env
.env.*
!.env.example

